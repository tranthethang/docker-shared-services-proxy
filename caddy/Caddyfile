{
	admin localhost:2019
	auto_https off
}

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	tls /etc/caddy/certs/server.crt /etc/caddy/certs/server.key

	# One file per stack: a named matcher plus a handle block with its upstream.
	import sites/*.caddy

	# No stack file matched this host.
	handle {
		respond "No DSS stack serves this host." 404
	}
}
